{
  "//": "DO NOT EDIT THIS FILE before reading the comments below:",

  "//": "TinyTapeout Configuration for Low-Power Approximate Multiplier",
  "//": "Design: Approximate 4x4 Multiplier using SKY130 OpenLane Flow",

  "PL_TARGET_DENSITY_PCT": 60,

  "//": "20ns = 50MHz",
  "CLOCK_PERIOD": 20,

  "//": "Hold slack margins",
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,

  "//": "Enable linter",
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  "//": "Clock port",
  "CLOCK_PORT": "clk",

  "//": "Save runtime",
  "RUN_KLAYOUT_XOR": 0,
  "RUN_KLAYOUT_DRC": 0,

  "//": "Do not buffer outputs",
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,

  "//": "Margins",
  "TOP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,

  "//": "Absolute sizing",
  "FP_SIZING": "absolute",

  "//": "Allow routing congestion",
  "GRT_ALLOW_CONGESTION": 1,

  "//": "IO lengths",
  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,

  "//": "PDN pitch",
  "FP_PDN_VPITCH": 38.87,

  "//": "Clock Tree Synthesis",
  "RUN_CTS": 1,

  "//": "Disable power rings",
  "FP_PDN_MULTILAYER": 0,

  "//": "Magic settings",
  "MAGIC_DEF_LABELS": 0,
  "MAGIC_WRITE_LEF_PINONLY": 1
}
